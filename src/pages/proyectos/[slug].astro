---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { projects } from '../../data/projects';
import type { ProjectImage } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const title = `${project.title} — ${project.category} en ${project.subtitle} | Suárez Studio`;
const description = project.description.slice(0, 155).trim() + '…';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: `${project.title} — ${project.category}`,
  description: project.description,
  creator: { '@type': 'Person', name: 'Vanessa Suárez' },
  about: project.subtitle,
};

// Images with a caption run as alternating image/text rows (left/right,
// right/left...); everything after that runs in pairs, with a lone last
// image (if the count is odd) shown on its own.
const captionedCount = project.images.filter((img) => img.caption).length;
const captioned = project.images.slice(0, captionedCount);
const rest = project.images.slice(captionedCount);

const pairs: ProjectImage[][] = [];
let lone: ProjectImage | null = null;
for (let i = 0; i < rest.length; i += 2) {
  if (i + 1 < rest.length) pairs.push([rest[i], rest[i + 1]]);
  else lone = rest[i];
}

const currentIndex = projects.findIndex((p) => p.slug === project.slug);
const nextProject = projects[(currentIndex + 1) % projects.length];
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <article class="project">
    <div class="back-link-wrap">
      <a href="/#proyectos" class="back-link">← Volver a proyectos</a>
    </div>
    <header class="project-header">
      <div class="header-grid">
        <div class="header-left">
          <p class="eyebrow">{project.category}</p>
          <h1>{project.title}</h1>
          <p class="subtitle">{project.subtitle}</p>
        </div>
        <div class="header-right">
          <p class="intro-text">{project.description}</p>
        </div>
      </div>
    </header>

    <div class="project-content">
      <div class="divider" />

      {
        captioned.map((img, i) => (
          <div class:list={['content-row', { rev: i % 2 === 1 }]}>
            <div class="row-img">
              <Image src={img.src} alt={img.alt} width={1200} height={800} loading={i === 0 ? 'eager' : 'lazy'} />
            </div>
            <div class="row-text">
              <p>{img.caption}</p>
            </div>
          </div>
        ))
      }

      {
        pairs.map((pair) => (
          <div class="pair">
            {pair.map((img) => (
              <div class="pair-img">
                <Image src={img.src} alt={img.alt} width={900} height={675} loading="lazy" />
              </div>
            ))}
          </div>
        ))
      }

      {
        lone && (
          <div class="lone">
            <Image src={lone.src} alt={lone.alt} width={1200} height={675} loading="lazy" />
          </div>
        )
      }
    </div>

    <div class="cta">
      <p>¿Tienes un espacio que te gustaría transformar así?</p>
      <a href="/#contacto" class="btn-solid">Cuéntame tu proyecto ↗</a>
    </div>

    <a href={`/proyectos/${nextProject.slug}/`} class="next-project">
      <span class="next-label">Siguiente proyecto</span>
      <span class="next-row">
        <span class="next-title">{nextProject.title}</span>
        <span class="next-arrow">→</span>
      </span>
    </a>
  </article>
</BaseLayout>

<style>
  .back-link-wrap {
    padding: clamp(120px, 18vh, 180px) clamp(20px, 4vw, 56px) 0;
  }
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 600;
    color: var(--muted-3);
    transition:
      color 0.2s ease,
      gap 0.2s ease;
  }
  .back-link:hover {
    color: var(--ink);
    gap: 12px;
  }

  .project-header {
    padding: clamp(20px, 3vh, 32px) clamp(20px, 4vw, 56px) clamp(32px, 5vh, 48px);
  }
  .header-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(28px, 5vw, 64px);
  }
  .header-left .eyebrow {
    margin-bottom: 18px;
  }
  .header-left h1 {
    font-size: clamp(2.8rem, 7vw, 6.5rem);
    line-height: 1;
    letter-spacing: -0.02em;
    margin-bottom: 20px;
  }
  .subtitle {
    font-size: clamp(16px, 1.4vw, 20px);
    color: var(--muted-3);
    max-width: 40ch;
  }
  .header-right {
    display: flex;
    align-items: flex-end;
  }
  .intro-text {
    font-size: clamp(16px, 1.2vw, 18px);
    line-height: 1.7;
    color: var(--body-copy);
    max-width: 56ch;
  }

  .project-content {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 clamp(20px, 4vw, 56px) clamp(70px, 10vh, 120px);
    display: flex;
    flex-direction: column;
    gap: clamp(56px, 8vh, 96px);
  }
  .divider {
    border-top: 1px solid var(--line);
  }

  /* Alternating image/text rows */
  .content-row {
    display: flex;
    align-items: center;
    gap: clamp(28px, 5vw, 64px);
  }
  .content-row.rev {
    flex-direction: row-reverse;
  }
  .row-img,
  .row-text {
    flex: 1;
    min-width: 0;
  }
  .row-img {
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }
  .row-img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1s var(--ease);
  }
  .row-img:hover :global(img) {
    transform: scale(1.035);
  }
  .row-text p {
    font-size: clamp(16px, 1.3vw, 18px);
    line-height: 1.7;
    color: var(--body-copy);
  }

  /* Pairs of uncaptioned images, side by side */
  .pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(16px, 2.5vw, 32px);
  }
  .pair-img {
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }
  .pair-img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s var(--ease);
  }
  .pair-img:hover :global(img) {
    transform: scale(1.04);
  }

  .lone {
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }
  .lone :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 720px) {
    .header-grid {
      grid-template-columns: 1fr;
    }
    .header-right {
      align-items: flex-start;
    }
    .content-row,
    .content-row.rev {
      flex-direction: column;
      align-items: stretch;
    }
    .pair {
      grid-template-columns: 1fr;
    }
  }

  .cta {
    max-width: 1240px;
    margin: 0 auto;
    padding: clamp(56px, 8vh, 96px) clamp(20px, 4vw, 56px) clamp(80px, 12vh, 140px);
    border-top: 1px solid var(--line);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 22px;
  }
  .cta p {
    font-size: clamp(1.3rem, 2.4vw, 1.7rem);
    font-weight: 600;
    letter-spacing: -0.01em;
    max-width: 32ch;
  }
  .btn-solid {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: var(--ink);
    color: #fff;
    padding: 15px 26px;
    border-radius: 100px;
    font-size: 15px;
    font-weight: 700;
    transition: opacity 0.3s ease;
  }
  .btn-solid:hover {
    opacity: 0.82;
  }

  .next-project {
    display: block;
    max-width: 1240px;
    margin: 0 auto;
    padding: clamp(28px, 4vh, 44px) clamp(20px, 4vw, 56px) clamp(56px, 9vh, 96px);
    border-top: 1px solid var(--line);
  }
  .next-label {
    display: block;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 14px;
  }
  .next-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }
  .next-title {
    font-size: clamp(2.2rem, 7vw, 5.5rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1;
    transition: opacity 0.3s ease;
  }
  .next-arrow {
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    color: var(--muted-3);
    flex: none;
    transition: transform 0.3s var(--ease);
  }
  .next-project:hover .next-title {
    opacity: 0.72;
  }
  .next-project:hover .next-arrow {
    transform: translateX(10px);
  }
</style>
