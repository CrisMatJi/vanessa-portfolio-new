---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { projects } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const title = `${project.title} — ${project.category} en ${project.subtitle} | Suárez Studio`;
const description = project.description.slice(0, 155).trim() + '…';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: `${project.title} — ${project.category}`,
  description: project.description,
  creator: { '@type': 'Person', name: 'Vanessa Suárez' },
  about: project.subtitle,
};
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <article class="project">
    <header class="project-hero">
      <Image src={project.cover} alt={project.coverAlt} width={1800} height={1000} priority />
      <div class="project-hero-content">
        <p class="eyebrow">{project.category}</p>
        <h1>{project.title}</h1>
        <p class="subtitle">{project.subtitle}</p>
      </div>
    </header>

    <div class="project-body section">
      <p class="description">{project.description}</p>

      <div class="gallery">
        {
          project.images.map((img) => (
            <figure class="gallery-item">
              <Image src={img.src} alt={img.alt} width={1400} height={933} />
              {img.caption && <figcaption>{img.caption}</figcaption>}
            </figure>
          ))
        }
      </div>

      <div class="cta">
        <p>¿Tienes un espacio que te gustaría transformar así?</p>
        <a href="/#contacto" class="btn-solid">Cuéntame tu proyecto ↗</a>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .project-hero {
    position: relative;
    color: #fff;
  }
  .project-hero :global(img) {
    width: 100%;
    height: clamp(360px, 70vh, 720px);
    object-fit: cover;
  }
  .project-hero-content {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: clamp(20px, 4vw, 56px) clamp(20px, 4vw, 56px) clamp(32px, 5vh, 64px);
    background: linear-gradient(180deg, rgba(10, 10, 10, 0) 40%, rgba(10, 10, 10, 0.75) 100%);
  }
  .project-hero-content .eyebrow {
    color: rgba(255, 255, 255, 0.75);
  }
  .project-hero-content h1 {
    font-size: clamp(2.6rem, 8vw, 6rem);
    line-height: 0.96;
    margin-top: 10px;
  }
  .subtitle {
    margin-top: 12px;
    font-size: clamp(16px, 1.6vw, 20px);
    color: rgba(255, 255, 255, 0.85);
    max-width: 50ch;
  }
  .description {
    font-size: clamp(17px, 1.8vw, 22px);
    line-height: 1.65;
    color: var(--body-copy);
    max-width: 72ch;
    margin-bottom: clamp(48px, 7vh, 88px);
  }
  .gallery {
    display: flex;
    flex-direction: column;
    gap: clamp(40px, 6vh, 72px);
  }
  .gallery-item :global(img) {
    width: 100%;
    height: auto;
    border-radius: 18px;
  }
  .gallery-item figcaption {
    margin-top: 16px;
    font-size: 15px;
    line-height: 1.6;
    color: var(--muted-3);
    max-width: 60ch;
  }
  .cta {
    margin-top: clamp(60px, 9vh, 100px);
    padding-top: clamp(40px, 6vh, 64px);
    border-top: 1px solid var(--line);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }
  .cta p {
    font-size: clamp(1.4rem, 2.4vw, 2rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    max-width: 30ch;
  }
  .btn-solid {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: var(--ink);
    color: #fff;
    padding: 18px 30px;
    border-radius: 100px;
    font-size: 15px;
    font-weight: 700;
    transition: opacity 0.3s ease;
  }
  .btn-solid:hover {
    opacity: 0.82;
  }
</style>
