---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../data/projects';

import heroImage from '../assets/images/hero-interior.png';
import vanessaPortrait from '../assets/images/vanessa.jpeg';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Suárez Studio — Vanessa Suárez, Interiorismo Arquitectónico',
  description:
    'Estudio de interiorismo en Cádiz: reformas, decoración y diseño de interiores en Cádiz, Jerez de la Frontera y Andalucía. Proyecto integral, llave en mano, renders 3D, planimetría y asesorías. Proyectos online en toda España.',
  url: 'https://www.suarezstudio.es/',
  telephone: '+34611444163',
  areaServed: ['Cádiz', 'Jerez de la Frontera', 'Andalucía', 'España'],
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Cádiz',
    addressRegion: 'Andalucía',
    addressCountry: 'ES',
  },
  founder: {
    '@type': 'Person',
    name: 'Vanessa Suárez',
    jobTitle: 'Interiorista',
  },
  sameAs: [
    'https://www.instagram.com/vanessa_suarez_interiorismo/',
    'https://www.linkedin.com/in/vanessa-calvente-suarez-932b14371/',
  ],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Servicios',
    itemListElement: [
      'Proyecto integral de interiorismo',
      'Proyecto llave en mano',
      'Seguimiento de obra',
      'Renders 3D',
      'Planimetría',
      'Asesorías de interiorismo',
    ].map((name) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name } })),
  },
};

const servicios = [
  'Decoración',
  'Mobiliario',
  'Materiales',
  'Acabados',
  'Nueva distribución',
  'Planimetría técnica',
  'Modelado / render 3D',
  'Acompañamiento en ejecución',
];
---

<BaseLayout
  title="Diseño de interiores y reformas en Cádiz y Jerez | Suárez Studio"
  description="Interiorista en Cádiz. Reformas, decoración y diseño de interiores en Jerez y toda Andalucía. Proyecto integral y renders 3D. Escríbeme por WhatsApp."
  jsonLd={jsonLd}
  darkHero
>
  <!-- Hero -->
  <section class="hero">
    <div class="hero-bg">
      <Image src={heroImage} alt="Salón interior con luz cálida, interiorismo Suárez Studio" width={1800} height={1200} priority />
    </div>
    <div class="hero-scrim"></div>
    <div class="hero-content">
      <div class="hero-top">
        <div class="hero-lede">
          <p data-reveal>
            Diseño y reformas de interiores con identidad, sensibilidad y detalle. Del plano y los renders hasta la
            última lámpara, en Cádiz capital, Jerez y el resto de Andalucía, y online en toda España.
          </p>
          <div data-reveal class="hero-ctas">
            <a href="#contacto" class="btn-solid">Empezar un proyecto ↗</a>
            <a href="#servicios" class="btn-outline">Ver servicios</a>
          </div>
        </div>
        <p data-reveal class="eyebrow hero-eyebrow">Interiorismo arquitectónico · Cádiz</p>
      </div>
      <h1 class="hero-title">
        <span class="reveal-line"><span data-reveal>Suárez Studio<span class="reg">®</span></span></span>
      </h1>
    </div>
  </section>

  <!-- Marquee band -->
  <section class="band">
    <div class="band-track">
      <span class="band-text">Casas que se parecen a quien vive en ellas</span>
      <span class="band-text" aria-hidden="true">Casas que se parecen a quien vive en ellas</span>
    </div>
    <div class="band-grid">
      <div data-reveal class="band-item">
        <p class="band-title">Vivienda particular</p>
        <p class="band-copy">Reformas integrales y casas que cambian de vida.</p>
      </div>
      <div data-reveal class="band-item">
        <p class="band-title">Obra nueva</p>
        <p class="band-copy">Unifamiliares desde el plano, junto a tu arquitecto.</p>
      </div>
      <div data-reveal class="band-item">
        <p class="band-title">Promoción e inversión</p>
        <p class="band-copy">Producto bien resuelto y renders que ayudan a vender.</p>
      </div>
      <div data-reveal class="band-item">
        <p class="band-title">Proyectos online</p>
        <p class="band-copy">Toda España, con el mismo nivel de detalle.</p>
      </div>
    </div>
  </section>

  <!-- Servicios -->
  <section id="servicios" class="section">
    <div class="section-head">
      <h2 class="h-xl">
        <span class="reveal-line"><span data-reveal>En qué puedo</span></span>
        <span class="reveal-line"><span data-reveal class="dim">ayudarte</span></span>
      </h2>
      <p class="eyebrow">01 — Servicios</p>
    </div>
    <div class="services-grid">
      {
        servicios.map((s, i) => (
          <article data-reveal class="service-card" style={`transition-delay:${(i % 4) * 0.07}s`}>
            <span class="service-num">{String(i + 1).padStart(2, '0')}</span>
            <h3>{s}</h3>
            <a href="#contacto" class="link">
              Consultar ↗
            </a>
          </article>
        ))
      }
    </div>
  </section>

  <!-- Proyectos -->
  <section id="proyectos" class="section proyectos">
    <div class="section-head">
      <h2 class="h-xl">
        <span class="reveal-line"><span data-reveal>Proyectos</span></span>
        <span class="reveal-line"><span data-reveal class="dim">realizados</span></span>
      </h2>
      <p class="eyebrow">02 — Proyectos</p>
    </div>
    <div class="proyectos-grid">
      {projects.map((project, i) => <ProjectCard project={project} index={i} />)}
    </div>
  </section>

  <!-- Proceso -->
  <section id="proceso" class="proceso">
    <div class="section-head dark">
      <h2 class="h-xl">
        <span class="reveal-line"><span data-reveal>Cinco fases,</span></span>
        <span class="reveal-line"><span data-reveal class="dim-light">cero sorpresas</span></span>
      </h2>
      <p class="proceso-lede">
        Casi todos los sustos de una reforma vienen de decisiones que se toman tarde. Este orden existe justamente
        para que eso no pase.
      </p>
    </div>
    <div class="proceso-list">
      <article class="proceso-card fase-1">
        <div>
          <span class="fase-tag">FASE 01</span>
          <h3>Nos conocemos</h3>
        </div>
        <div>
          <p class="fase-copy">
            Primera conversación, dossier informativo, visita, medición y estudio de necesidades.
          </p>
        </div>
      </article>

      <article class="proceso-card fase-2">
        <div>
          <span class="fase-tag">FASE 02</span>
          <h3>Definimos el proyecto</h3>
        </div>
        <div>
          <p class="fase-copy">Alcance, propuesta de trabajo y presupuesto.</p>
        </div>
      </article>

      <article class="proceso-card fase-3">
        <div>
          <span class="fase-tag">FASE 03</span>
          <h3>Diseñamos</h3>
        </div>
        <div>
          <p class="fase-copy">Concepto, distribución, materiales y propuestas de diseño.</p>
        </div>
      </article>

      <article class="proceso-card fase-4">
        <div>
          <span class="fase-tag">FASE 04</span>
          <h3>Perfeccionamos</h3>
        </div>
        <div>
          <p class="fase-copy">Presentación del proyecto y rondas de ajustes.</p>
        </div>
      </article>

      <article class="proceso-card fase-5">
        <div>
          <span class="fase-tag">FASE 05</span>
          <h3>Lo hacemos realidad</h3>
        </div>
        <div>
          <p class="fase-copy">
            Proyecto final, documentación y, si lo deseas, acompañamiento en obra.
          </p>
        </div>
      </article>
    </div>
  </section>

  <!-- Estudio / Sobre mí -->
  <section id="estudio" class="section estudio">
    <div class="estudio-grid">
      <div data-reveal class="estudio-photo">
        <Image src={vanessaPortrait} alt="Retrato de Vanessa Suárez, interiorista" width={900} height={1200} />
      </div>
      <div class="estudio-copy">
        <p class="eyebrow">03 — Sobre mí</p>
        <h2 class="h-lg">
          <span class="reveal-line"><span data-reveal>Trabajo</span></span>
          <span class="reveal-line"><span data-reveal class="dim">de una en una</span></span>
        </h2>
        <p class="body-copy">
          Hola, soy Vanessa Suárez, interiorista y decoradora de interiores, fundadora de Suárez Studio.
        </p>
        <p class="body-copy">
          Para mí, diseñar un espacio va mucho más allá de hacerlo bonito. Se trata de escuchar, comprender tus
          necesidades reales y crear un lugar en el que puedas reconocerte y sentirte bien.
        </p>
        <p class="body-copy">
          Me apasionan el color, la naturalidad de los materiales y la calidez que aportan las diferentes luces.
          Busco el equilibrio entre belleza y funcionalidad para diseñar interiores coherentes, acogedores y llenos
          de personalidad.
        </p>
        <p class="body-copy">
          Creo espacios con alma, que no solo se vean, sino que también se sientan. Espacios que hablen de las
          personas que los habitan, de su historia y de su forma de vivir.
        </p>
        <p class="body-copy">
          Si quieres crear un lugar que se parezca de verdad a ti, estaré encantada de acompañarte.
        </p>
        <div class="estudio-stats">
          <div><p class="stat">Cádiz</p><p class="stat-label">base del estudio</p></div>
          <div><p class="stat">Online</p><p class="stat-label">resto de España</p></div>
          <div><p class="stat">Una</p><p class="stat-label">interlocutora, de principio a fin</p></div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="section">
    <div class="faq-grid">
      <div>
        <p class="eyebrow" style="margin-bottom:20px">04 — Dudas frecuentes</p>
        <h2 class="h-lg">
          <span class="reveal-line"><span data-reveal>Lo que todo el mundo me pregunta</span></span>
        </h2>
      </div>
      <div class="faq-list">
        <details class="faq-item">
          <summary>¿Cuánto cuesta una reforma?</summary>
          <p>
            Depende de los metros, del estado de la vivienda y de lo que realmente necesites. No es lo mismo un
            proyecto centrado en decoración que uno que requiere nueva distribución, planimetría o modificaciones
            de obra. En la primera consulta podremos orientarte según tu caso.
          </p>
        </details>
        <details class="faq-item">
          <summary>¿Es necesario hacer obra para mejorar mi casa?</summary>
          <p>
            No siempre. Antes de plantear una obra estudiamos el espacio y vemos hasta dónde podemos llegar con
            distribución, iluminación, mobiliario, materiales y decoración. Si podemos conseguir un buen resultado
            sin hacer una intervención mayor, te lo diremos.
          </p>
        </details>
        <details class="faq-item">
          <summary>¿Qué incluye la primera consulta?</summary>
          <p>
            Es el punto de partida para conocer tu vivienda, tus necesidades y lo que quieres conseguir. Además,
            recibirás un dossier con información sobre nuestros servicios, forma de trabajo y todo lo necesario
            para entender cómo podemos abordar tu proyecto.
          </p>
        </details>
        <details class="faq-item">
          <summary>¿Puedo contratar solo el proyecto, sin la obra?</summary>
          <p>
            Claro. Mucha gente contrata proyecto, planimetría y renders y ejecuta con su propio constructor. La
            documentación se entrega lista para presupuestar sin depender de mí.
          </p>
        </details>
      </div>
    </div>
  </section>

  <!-- Contacto -->
  <section id="contacto" class="contacto">
    <h2 class="h-xxl">
      <span class="reveal-line"><span data-reveal>Cuéntame qué</span></span>
      <span class="reveal-line"><span data-reveal class="dim-light">necesitas</span></span>
    </h2>
    <div class="contacto-grid">
      <div class="contacto-left">
        <p class="contacto-lede">Te responderé yo, Vanessa. Normalmente en el mismo día.</p>
        <WhatsAppButton />
        <div class="contacto-info">
          <a href="mailto:vanessa.cal.sua@gmail.com">vanessa.cal.sua@gmail.com</a>
          <a href="tel:+34611444163">+34 611 44 41 63</a>
          <p>Cádiz · Andalucía · Proyectos online en toda España</p>
        </div>
      </div>

      <div class="contacto-right">
        <p id="form-status-sent" class="form-sent" hidden>
          <span class="form-sent-title">Recibido. Gracias.</span>
          <span
            >Te escribo en menos de 24&nbsp;h laborables. Si tienes prisa, mándame un WhatsApp y lo vemos antes.</span
          >
        </p>
        <form id="contact-form" class="form">
          <p class="eyebrow">O escríbeme aquí</p>
          <div class="form-row">
            <label>Nombre<input name="from_name" type="text" required placeholder="Nombre y apellidos" /></label>
            <label>Email<input name="reply_to" type="email" required placeholder="tu@email.com" /></label>
          </div>
          <div class="form-row">
            <label>Teléfono<input name="telefono" type="tel" placeholder="Opcional" /></label>
            <label>Localidad<input name="localidad" type="text" placeholder="Cádiz, Jerez, Sevilla…" /></label>
          </div>
          <div class="form-row">
            <label>
              Servicio
              <select name="servicio">
                <option>Proyecto integral de interiorismo</option>
                <option>Proyecto llave en mano</option>
                <option>Seguimiento de obra</option>
                <option>Renders 3D</option>
                <option>Planimetría</option>
                <option>Asesorías de interiorismo</option>
              </select>
            </label>
            <label>
              Tipo de cliente
              <select name="perfil">
                <option>Reformo mi vivienda</option>
                <option>Obra nueva / unifamiliar</option>
                <option>Promotor o inversor</option>
                <option>Proyecto online, fuera de Andalucía</option>
              </select>
            </label>
          </div>
          <label>Cuéntame<textarea name="mensaje_extra" rows="4" placeholder="Metros, estado de la vivienda, plazos, qué te gustaría conseguir…"
            ></textarea></label>
          <input type="hidden" name="subject" value="Nueva consulta desde suarezstudio.es" />
          <input type="hidden" name="message" />
          <label class="form-checkbox">
            <input type="checkbox" required />
            <span>He leído y acepto la <a href="/privacidad">política de privacidad</a>. Tus datos se usan solo para responderte.</span>
          </label>
          <button type="submit" class="btn-solid form-submit">Enviar consulta ↗</button>
          <p id="form-status-error" class="form-error" hidden>Algo salió mal. Escríbeme directamente por WhatsApp o email.</p>
        </form>
      </div>
    </div>
  </section>

  <!-- Zonas -->
  <section id="zonas" class="section zonas">
    <h2 class="h-md">
      <span class="reveal-line"><span data-reveal>Dónde trabajo</span></span>
    </h2>
    <p class="zonas-lede">
      Diseño de interiores en Cádiz y Jerez de la Frontera de forma presencial, y proyectos de interiorismo online
      en el resto de Andalucía y toda España.
    </p>
    <div class="zonas-grid">
      <div>
        <h3 class="zonas-title">Provincia de Cádiz</h3>
        <p class="zonas-copy">
          Cádiz · Jerez de la Frontera · El Puerto de Santa María · San Fernando · Chiclana · Puerto Real · Sanlúcar
          de Barrameda · Rota · Conil · Vejer · Tarifa
        </p>
      </div>
      <div>
        <h3 class="zonas-title">Resto de Andalucía</h3>
        <p class="zonas-copy">Sevilla · Málaga · Marbella · Estepona · Huelva · Córdoba · Granada</p>
      </div>
      <div>
        <h3 class="zonas-title">Toda España, online</h3>
        <p class="zonas-copy">
          Proyecto completo, planimetría y renders a distancia, con videollamadas de seguimiento en obra. Sin
          desplazamientos que encarezcan el presupuesto.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import emailjs from '@emailjs/browser';

  const SERVICE_ID = 'service_fu6s5ou';
  const TEMPLATE_ID = 'template_eezjrti';
  const PUBLIC_KEY = '1JgEPD0mQL9idQIIo';

  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const sent = document.getElementById('form-status-sent');
  const errorMsg = document.getElementById('form-status-error');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const combined = [
      `Teléfono: ${data.get('telefono') || '—'}`,
      `Localidad: ${data.get('localidad') || '—'}`,
      `Servicio: ${data.get('servicio')}`,
      `Tipo de cliente: ${data.get('perfil')}`,
      '',
      String(data.get('mensaje_extra') || ''),
    ].join('\n');
    (form.elements.namedItem('message') as HTMLInputElement).value = combined;

    const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    submitBtn.disabled = true;
    errorMsg?.setAttribute('hidden', '');

    try {
      await emailjs.sendForm(SERVICE_ID, TEMPLATE_ID, form, { publicKey: PUBLIC_KEY });
      form.hidden = true;
      sent?.removeAttribute('hidden');
    } catch {
      errorMsg?.removeAttribute('hidden');
      submitBtn.disabled = false;
    }
  });
</script>

<style>
  /* Hero */
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    overflow: hidden;
    background: var(--ink);
    color: #fff;
  }
  .hero-bg {
    position: absolute;
    inset: -6% 0;
  }
  .hero-bg :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(10, 10, 10, 0.55) 0%,
      rgba(10, 10, 10, 0.15) 32%,
      rgba(10, 10, 10, 0.72) 78%,
      rgba(10, 10, 10, 0.9) 100%
    );
  }
  .hero-content {
    position: relative;
    padding: 0 clamp(20px, 4vw, 56px) clamp(18px, 3vh, 34px);
    display: flex;
    flex-direction: column;
    gap: clamp(28px, 5vh, 58px);
  }
  .hero-top {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 28px;
  }
  .hero-lede {
    display: flex;
    flex-direction: column;
    gap: 22px;
    max-width: 38ch;
  }
  .hero-lede p {
    font-size: clamp(16px, 1.35vw, 20px);
    line-height: 1.5;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.92);
  }
  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .btn-solid {
    display: flex;
    align-items: center;
    gap: 10px;
    background: #fff;
    color: var(--ink);
    padding: 18px 30px;
    border-radius: 100px;
    font-size: 15px;
    font-weight: 700;
    transition: opacity 0.3s ease;
    width: fit-content;
  }
  .btn-solid:hover {
    opacity: 0.82;
  }
  .btn-outline {
    display: flex;
    align-items: center;
    padding: 18px 30px;
    border: 1.5px solid rgba(255, 255, 255, 0.5);
    border-radius: 100px;
    font-size: 15px;
    font-weight: 600;
    color: #fff;
    transition:
      background 0.3s ease,
      color 0.3s ease,
      border-color 0.3s ease;
  }
  .btn-outline:hover {
    background: #fff;
    color: var(--ink);
    border-color: #fff;
  }
  .hero-eyebrow {
    color: rgba(255, 255, 255, 0.62);
  }
  .hero-title {
    font-size: clamp(2.6rem, 12vw, 15rem);
    line-height: 0.92;
    letter-spacing: -0.045em;
    font-weight: 800;
  }
  .reg {
    font-size: 0.34em;
    vertical-align: top;
    line-height: 1;
    letter-spacing: 0;
  }
  /* Band */
  .band {
    background: var(--ink);
    color: #fff;
    padding: clamp(56px, 9vh, 110px) 0 clamp(46px, 7vh, 86px);
    overflow: hidden;
  }
  .band-track {
    display: inline-flex;
    white-space: nowrap;
    animation: band-marquee 26s linear infinite;
    will-change: transform;
  }

  .band-text {
    font-size: clamp(2.6rem, 9.4vw, 11rem);
    line-height: 1;
    letter-spacing: -0.04em;
    font-weight: 800;
    padding-left: clamp(20px, 4vw, 56px);
  }

  @keyframes band-marquee {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .band-track {
      animation: none;
    }
  }
  .band-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 28px;
    padding: clamp(40px, 6vh, 72px) clamp(20px, 4vw, 56px) 0;
  }
  .band-item {
    border-top: 1px solid #333;
    padding-top: 18px;
  }
  .band-title {
    font-size: clamp(17px, 1.5vw, 20px);
    font-weight: 700;
  }
  .band-copy {
    font-size: 14px;
    color: var(--muted);
    margin-top: 8px;
    line-height: 1.55;
  }

  /* Shared section heads */
  .section-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    border-bottom: 1px solid var(--line);
    padding-bottom: 26px;
    margin-bottom: clamp(40px, 6vh, 68px);
  }
  .h-xl {
    font-size: clamp(2.4rem, 6.2vw, 6rem);
    line-height: 0.98;
    max-width: 16ch;
  }
  .h-lg {
    font-size: clamp(2.2rem, 5vw, 4.6rem);
    line-height: 1;
  }
  .h-md {
    font-size: clamp(1.8rem, 3.4vw, 3.2rem);
    line-height: 1.05;
    margin-bottom: 26px;
  }
  .h-xxl {
    font-size: clamp(2.6rem, 8vw, 9rem);
    line-height: 0.96;
    max-width: 15ch;
    margin-bottom: clamp(40px, 6vh, 70px);
  }
  .dim {
