---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations } from '../../i18n/utils';

const lang = Astro.currentLocale ?? 'es';
const t = useTranslations(lang);
---

<BaseLayout title={t.meta.cookies.title} description={t.meta.cookies.description} noindex>
  <section class="section legal">
    <h1>{t.cookies.h1}</h1>
    <p class="draft-note">
      {t.cookies.draftNote}
    </p>
    <p>{t.cookies.body}</p>
  </section>
</BaseLayout>

<style>
  .legal {
    max-width: 72ch;
    padding-top: clamp(140px, 20vh, 200px);
  }
  .legal h1 {
    font-size: clamp(2rem, 4vw, 3rem);
    margin-bottom: 24px;
  }
  .legal p {
    font-size: 16px;
    line-height: 1.7;
    color: var(--body-copy);
    margin-bottom: 16px;
  }
  .draft-note {
    background: var(--panel);
    padding: 16px 20px;
    border-radius: 12px;
    font-size: 14px;
    color: var(--muted-3);
  }
</style>
