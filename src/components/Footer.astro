---
import { Image } from 'astro:assets';
import icon from '../assets/images/icon-black.png';
import { useTranslations, localizePath } from '../i18n/utils';

const year = new Date().getFullYear();
const lang = Astro.currentLocale ?? 'es';
const t = useTranslations(lang);
---

<footer class="footer">
  <div class="grid">
    <div class="brand">
      <Image src={icon} alt="Suárez Studio" width={573} height={952} class="brand-logo" />
      <p>{t.footer.brand}</p>
    </div>
    <div class="col">
      <p class="col-title">{t.footer.navTitle}</p>
      <a href={localizePath('/#servicios', lang)}>{t.nav.services}</a>
      <a href={localizePath('/#proyectos', lang)}>{t.nav.projects}</a>
      <a href={localizePath('/#proceso', lang)}>{t.footer.navHow}</a>
      <a href={localizePath('/#estudio', lang)}>{t.footer.navAbout}</a>
      <a href={localizePath('/#contacto', lang)}>{t.nav.contact}</a>
    </div>
    <div class="col">
      <p class="col-title">{t.footer.servicesTitle}</p>
      <a href={localizePath('/#servicios', lang)}>{t.catalog.integral}</a>
      <a href={localizePath('/#servicios', lang)}>{t.catalog.llaveEnMano}</a>
      <a href={localizePath('/#servicios', lang)}>{t.catalog.seguimiento}</a>
      <a href={localizePath('/#servicios', lang)}>{t.catalog.renders}</a>
      <a href={localizePath('/#servicios', lang)}>{t.catalog.planimetria}</a>
      <a href={localizePath('/#servicios', lang)}>{t.catalog.asesorias}</a>
    </div>
    <div class="col">
      <p class="col-title">{t.footer.contactTitle}</p>
      <a href="mailto:vanessa.cal.sua@gmail.com">vanessa.cal.sua@gmail.com</a>
      <a href="tel:+34611444163">+34 611 44 41 63</a>
      <a href="https://www.instagram.com/vanessa_suarez_interiorismo/" target="_blank" rel="noopener">Instagram</a>
      <a href="https://www.linkedin.com/in/vanessa-calvente-suarez-932b14371/" target="_blank" rel="noopener"
        >LinkedIn</a
      >
    </div>
  </div>
  <div class="bottom">
    <p>&copy; {year} Suárez Studio · Cádiz</p>
    <div class="legal">
      <a href={localizePath('/aviso-legal', lang)}>{t.footer.legalAviso}</a>
      <a href={localizePath('/privacidad', lang)}>{t.footer.legalPrivacidad}</a>
      <a href={localizePath('/cookies', lang)}>{t.footer.legalCookies}</a>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding: clamp(48px, 7vh, 80px) clamp(20px, 4vw, 56px) 34px;
    display: flex;
    flex-direction: column;
    gap: 42px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 30px;
  }

  .brand-logo {
    width: auto;
    height: 44px;
    margin-bottom: 14px;
  }

  .brand p {
    font-size: 14px;
    color: var(--muted-3);
    line-height: 1.6;
    max-width: 28ch;
  }

  .col {
    display: flex;
    flex-direction: column;
    gap: 9px;
    font-size: 15px;
    color: var(--muted-3);
  }

  .col a:hover {
    color: var(--ink);
  }

  .col-title {
    color: var(--ink);
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .bottom {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    justify-content: space-between;
    border-top: 1px solid var(--line);
    padding-top: 22px;
    font-size: 13px;
    color: var(--muted);
  }

  .legal {
    display: flex;
    gap: 20px;
  }
</style>
