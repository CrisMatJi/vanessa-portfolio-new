---
import { Image } from 'astro:assets';
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  index: number;
}
const { project, index } = Astro.props;
---

<article data-reveal class="card" style={`transition-delay:${index * 0.08}s`}>
  <a href={`/proyectos/${project.slug}/`} class="cover">
    <Image src={project.cover} alt={project.coverAlt} width={800} height={600} />
  </a>
  <div class="body">
    <span class="category">{project.category}</span>
    <h3><a href={`/proyectos/${project.slug}/`}>{project.title}</a></h3>
    <p>{project.subtitle}</p>
    <a href={`/proyectos/${project.slug}/`} class="link">Ver proyecto ↗</a>
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .cover {
    display: block;
    border-radius: 18px;
    overflow: hidden;
    aspect-ratio: 4 / 3;
  }

  .cover :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease);
  }

  .cover:hover :global(img) {
    transform: scale(1.05);
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .category {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted-4);
  }

  h3 {
    font-size: clamp(1.6rem, 2.4vw, 2.2rem);
  }

  h3 a:hover {
    color: var(--muted-4);
  }

  .body p {
    font-size: 15px;
    color: var(--muted-3);
  }

  .link {
    margin-top: 8px;
    font-size: 14px;
    font-weight: 700;
    border-bottom: 1.5px solid currentColor;
    padding-bottom: 4px;
    align-self: flex-start;
  }
</style>
