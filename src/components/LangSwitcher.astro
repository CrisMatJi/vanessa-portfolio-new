---
import { languages, type Lang } from '../i18n/ui';
import { useTranslations, getAlternatePath, getAlternateLang } from '../i18n/utils';

const lang = (Astro.currentLocale ?? 'es') as Lang;
const t = useTranslations(lang);
const altLang = getAlternateLang(lang);
const altPath = getAlternatePath(Astro.url.pathname, lang);
---

<a href={altPath} class="lang-switch" aria-label={t.langSwitcherLabel} data-lang-switch>
  {languages[altLang]}
</a>

<style>
  .lang-switch {
    display: flex;
    align-items: center;
    padding: 8px 16px;
    border: 1px solid rgba(255, 255, 255, 0.5);
    border-radius: 100px;
    font-size: 13px;
    font-weight: 600;
    white-space: nowrap;
    transition:
      background 0.3s ease,
      color 0.3s ease,
      border-color 0.3s ease;
  }

  .lang-switch:hover {
    background: #fff;
    color: var(--ink);
    border-color: #fff;
  }

  :global(.header.is-solid) .lang-switch {
    border-color: var(--line);
  }

  :global(.header.is-solid) .lang-switch:hover {
    background: var(--ink);
    color: #fff;
    border-color: var(--ink);
  }
</style>
