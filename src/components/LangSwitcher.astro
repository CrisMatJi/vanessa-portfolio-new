---
import { type Lang } from '../i18n/ui';
import { useTranslations, getAlternatePath, getAlternateLang } from '../i18n/utils';

const lang = (Astro.currentLocale ?? 'es') as Lang;
const t = useTranslations(lang);
const altLang = getAlternateLang(lang);
const altPath = getAlternatePath(Astro.url.pathname, lang);
---

<a href={altPath} class="lang-switch" aria-label={t.langSwitcherLabel} data-lang-switch>
  {
    altLang === 'es' ? (
      <svg viewBox="0 0 3 2" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
        <rect width="3" height="2" fill="#AA151B" />
        <rect width="3" height="1" y="0.5" fill="#F1BF00" />
      </svg>
    ) : (
      <svg viewBox="0 0 60 30" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
        <clipPath id="gb-round"><circle cx="30" cy="15" r="30" /></clipPath>
        <g clip-path="url(#gb-round)">
          <rect width="60" height="30" fill="#012169" />
          <path d="M0,0 L60,30 M60,0 L0,30" stroke="#fff" stroke-width="6" />
          <path d="M0,0 L60,30 M60,0 L0,30" stroke="#C8102E" stroke-width="2" />
          <path d="M30,0 V30 M0,15 H60" stroke="#fff" stroke-width="10" />
          <path d="M30,0 V30 M0,15 H60" stroke="#C8102E" stroke-width="6" />
        </g>
      </svg>
    )
  }
</a>

<style>
  .lang-switch {
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    width: 38px;
    height: 38px;
    border: 1px solid rgba(255, 255, 255, 0.5);
    border-radius: 50%;
    transition:
      background 0.3s ease,
      border-color 0.3s ease,
      transform 0.2s ease;
  }

  .lang-switch svg {
    width: 100%;
    height: 100%;
  }

  .lang-switch:hover {
    background: rgba(255, 255, 255, 0.12);
    border-color: #fff;
    transform: scale(1.06);
  }

  :global(.header.is-solid) .lang-switch {
    border-color: var(--line);
  }

  :global(.header.is-solid) .lang-switch:hover {
    background: var(--panel);
    border-color: var(--ink);
  }
</style>
