---
import { languages, type Lang } from '../i18n/ui';
import { useTranslations, getAlternatePath } from '../i18n/utils';
import FlagIcon from './FlagIcon.astro';

const lang = (Astro.currentLocale ?? 'es') as Lang;
const t = useTranslations(lang);
const pathname = Astro.url.pathname;
const otherPath = getAlternatePath(pathname, lang);
const esPath = lang === 'es' ? pathname : otherPath;
const enPath = lang === 'en' ? pathname : otherPath;
---

<div class="lang-switch" data-lang-switch>
  <button
    type="button"
    class="lang-trigger"
    aria-haspopup="true"
    aria-expanded="false"
    aria-label={t.langSwitcherLabel}
    data-lang-trigger
  >
    <span class="flag"><FlagIcon code={lang} /></span>
    <span class="code">{lang.toUpperCase()}</span>
    <svg
      class="chevron"
      width="11"
      height="11"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <polyline points="6 9 12 15 18 9"></polyline>
    </svg>
  </button>

  <div class="lang-menu" data-lang-menu>
    <a href={esPath} class:list={['lang-option', { active: lang === 'es' }]}>
      <span class="flag"><FlagIcon code="es" /></span>
      <span>{languages.es}</span>
    </a>
    <a href={enPath} class:list={['lang-option', { active: lang === 'en' }]}>
      <span class="flag"><FlagIcon code="en" /></span>
      <span>{languages.en}</span>
    </a>
  </div>
</div>

<style>
  .lang-switch {
    position: relative;
  }

  .lang-trigger {
    display: flex;
    align-items: center;
    gap: 9px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.5);
    border-radius: 100px;
    padding: 7px 14px 7px 8px;
    cursor: pointer;
    font-family: inherit;
    color: #fff;
    transition:
      background 0.25s ease,
      border-color 0.25s ease;
  }

  .lang-trigger:hover {
    background: rgba(255, 255, 255, 0.16);
    border-color: #fff;
  }

  .lang-trigger .flag {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    overflow: hidden;
    flex: none;
    display: flex;
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.3) inset;
  }

  .lang-trigger .flag :global(svg) {
    width: 100%;
    height: 100%;
  }

  .lang-trigger .code {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.03em;
  }

  .lang-trigger .chevron {
    transition: transform 0.25s ease;
  }

  .lang-switch.is-open .lang-trigger .chevron {
    transform: rotate(180deg);
  }

  .lang-menu {
    position: absolute;
    top: calc(100% + 10px);
    right: 0;
    background: #fff;
    border-radius: 16px;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.24);
    padding: 6px;
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 160px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    transition:
      opacity 0.2s ease,
      transform 0.2s ease,
      visibility 0.2s;
    z-index: 10;
  }

  .lang-switch.is-open .lang-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .lang-option {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    border-radius: 11px;
    color: #0a0a0a;
    font-size: 14px;
    font-weight: 600;
  }

  .lang-option:hover {
    background: #f2f2f2;
  }

  .lang-option.active {
    background: #f2f2f2;
  }

  .lang-option .flag {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    overflow: hidden;
    flex: none;
    display: flex;
  }

  .lang-option .flag :global(svg) {
    width: 100%;
    height: 100%;
  }

  /* Solid (light) header state */
  :global(.header.is-solid) .lang-trigger {
    background: transparent;
    border-color: var(--line);
    color: var(--ink);
  }

  :global(.header.is-solid) .lang-trigger:hover {
    background: var(--panel);
    border-color: var(--ink);
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-lang-switch]').forEach((wrap) => {
    const trigger = wrap.querySelector<HTMLButtonElement>('[data-lang-trigger]');
    if (!trigger) return;

    const close = () => {
      wrap.classList.remove('is-open');
      trigger.setAttribute('aria-expanded', 'false');
    };

    trigger.addEventListener('click', (e) => {
      e.stopPropagation();
      const open = wrap.classList.toggle('is-open');
      trigger.setAttribute('aria-expanded', String(open));
    });

    document.addEventListener('click', (e) => {
      if (!wrap.contains(e.target as Node)) close();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') close();
    });
  });
</script>
